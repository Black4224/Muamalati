# Copy this file to .env (same folder level as README.md) and edit. NEVER commit the real .env file.

# Which assistant to use:
#   groq   = a real language model through Groq (needs the two lines below)
#   rules  = offline keyword mode: no key, no internet, understands common questions only (good fallback for a demo)
AI_PROVIDER=groq

# Uncomment and fill in to enable the real model. Pick a Groq model that supports tool calling.
# GROQ_API_KEY=
# GROQ_MODEL=

# Optional: if the AI provider is temporarily down (rate limit / timeout / connection), answer with the offline rules mode
# and label the reply as degraded, instead of showing an error. Never hides a bad key.
# AI_FALLBACK_TO_RULES=true

DATABASE_URL=sqlite:///./sme_assistant.db
CORS_ORIGINS=http://localhost:5173
